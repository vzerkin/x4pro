SQL:
select *                                  
 ,y  as YY, dy  as dYY                    
 ,x1 as En, dx1 as dEn                    
from uni1                                 
where                                     
 Target like 'u-233'                 
 and (  (Reaction like 'n,el') ) 
 and SF58 like ',eta'                 
 and x2 is null                           
 and sf8=''  
order by fullCode,YearRef1 desc,DatasetID 
 ,En,iPoint                               


