---getX4SqlSearch_NUBAR: u-235 n,el ,eta  and sf8='' 
SQL:
select *                                  
 ,y  as YY, dy  as dYY                    
 ,x1 as En, dx1 as dEn                    
from uni1                                 
where                                     
 Target like 'u-235'                 
 and (  (Reaction like 'n,el') ) 
 and SF58 like ',eta'                 
 and x2 is null                           
 and sf8=''  
order by fullCode,YearRef1 desc,DatasetID 
 ,En,iPoint                               


