SQL:
select *                                  
 ,y  as FY, dy  as dFY                    
 ,x1 as En, dx1 as dEn                    
 ,x2 as zap                               
from uni2                                 
where Target like 'Pu-239'            
 and prod like '%Mo-99'
 and Reaction='N,F' and Quant='FY'        
 and SF58='CUM,FY' and SF8=''             
 order by fullCode,YearRef1 desc,DatasetID 
 ,En,iPoint                               


