SQL:
select *                                  
 ,y  as FY, dy  as dFY                    
 ,x1 as En, dx1 as dEn                    
 ,x2 as zap                               
from uni2                                 
where Target like 'u-235'            
 and prod like '%cd-115-g'
 and Reaction='N,F' and Quant='FY'        
 and SF58='CUM,FY' and SF8=''             
 order by fullCode,YearRef1 desc,DatasetID 
 ,En,iPoint                               


