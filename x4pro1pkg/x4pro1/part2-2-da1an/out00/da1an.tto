___getX4SqlSearch_DA_e: O-16 n,el  and (En>13900000.0 and En<14300000.0)
SQL:
select *                          
from da1                          
where (Target like 'O-16')  
  and (Reaction like 'n,el') 
--  and ((Author1 like 'Korzh') or (Author1 like 'Mellema'))
 and (En>13900000.0 and En<14300000.0)

