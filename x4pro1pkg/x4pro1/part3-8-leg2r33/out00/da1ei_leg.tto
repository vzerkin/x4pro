---Retrieve [,DA,,LEG] from EXFOR SQL database---
___getX4SqlSearch_DA_LEG: Li-6 p,he3
SQL:
select t1.Entry                        
 ,t1.DatasetID                         
 ,t1.Target,t1.Reaction                
 ,t1.YearRef1,t1.nAuthors              
 ,t1.Author1Ini,t1.Author1             
 ,t1.fullCode,t1.iPoint                
 ,t1.zaTarget1,t1.zaIncident1          
 ,t1.Projectile,t1.sProd,t1.sTarg      
 ,t1.MF as MF ,t1.MT as MT             
 ,t1.y as LEG,t1.dy as dLEG            
 ,h0.cm as LEG_CM                      
 ,t1.x1 as En,t1.dx1 as dEn            
 ,t1.x2 as number                      
 from uni1 as t1                       
 inner join x4pro_hdr as h0            
 on h0.DatasetID=t1.DatasetID and h0.typ='c' and h0.ihdr=0
 where 1=1                             
 and (t1.Target like 'Li-6')     
 and (t1.Reaction like 'p,he3')    
 and (t1.SF58 like ',DA,,LEG') and (t1.SF8 like 'LEG')
 and (t1.DatasetID='F0012004') 


 order by t1.fullCode,t1.YearRef1 desc 
 ,t1.DatasetID,En,number               


