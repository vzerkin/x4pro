---Retrieve EXFOR data from SQL database---
---getX4SqlSearch_Reacodes: xn= x2  reacodes: ['90-TH-232(N,F),PR,NU/DE', '90-TH-232(N,F),PR,NU/DE,,NPD', '90-TH-232(N,F),PR,NU/DE,,REL']
SQL:
select distinct                                            
 uni2.DatasetID,fullCode,iPoint                            
 ,YearRef1,uni2.Author1Ini,uni2.Author1                    
 ,Target,Reaction,Quant,SF8,uni2.MF,uni2.MT,yformula       
 ,yval,ShortHelp,SF8                                       
 ,uni2.Author1 as a1                                       
 ,uni2.DatasetID as dsid                                   
 ,x1,x2,x3,x4,x5,dx1,dx2,dx3,dx4,dx5                       
 ,y  as YY, dy  as dYY                                     
 ,x2 as XX, dx2 as dXX                             
 ,hy.BasicUnits as yBasicUnits, hy.expansion as yexpansion 
 ,hx.BasicUnits as xBasicUnits, hx.expansion as xexpansion 
 ,hx1.BasicUnits as x1BasicUnits, hx1.famCode as x1family  
 ,hx2.BasicUnits as x2BasicUnits, hx2.famCode as x2family  
 ,hx3.BasicUnits as x3BasicUnits, hx3.famCode as x3family  
 ,hx4.BasicUnits as x4BasicUnits, hx4.famCode as x4family  
 ,hx5.BasicUnits as x5BasicUnits, hx5.famCode as x5family  
 ,json_extract(x4cdat.xdat,'$.KT-NRM') as KT_NRM           
 from uni2                                                 
 left join DICT036 on DICT036.Code=uni2.SF58               
 join x4pro_ds  as ds on ds.DatasetID=uni2.DatasetID       
 inner join x4pro_x4cdat as x4cdat on x4cdat.DatasetID=uni2.DatasetID        
 join x4pro_hdr as hy on hy.DatasetID=uni2.DatasetID and hy.hdr='y'          
 join x4pro_hdr as hx on hx.DatasetID=uni2.DatasetID and hx.hdr='x2'     
 left join x4pro_hdr as hx1 on hx1.DatasetID=uni2.DatasetID and hx1.hdr='x1' 
 left join x4pro_hdr as hx2 on hx2.DatasetID=uni2.DatasetID and hx2.hdr='x2' 
 left join x4pro_hdr as hx3 on hx3.DatasetID=uni2.DatasetID and hx3.hdr='x3' 
 left join x4pro_hdr as hx4 on hx4.DatasetID=uni2.DatasetID and hx4.hdr='x4' 
 left join x4pro_hdr as hx5 on hx5.DatasetID=uni2.DatasetID and hx5.hdr='x5' 
 where 1=1 
 and (
  (fullCode like '90-TH-232(N,F),PR,NU/DE')
 or (fullCode like '90-TH-232(N,F),PR,NU/DE,,NPD')
 or (fullCode like '90-TH-232(N,F),PR,NU/DE,,REL')
 ) 
 and x1>=14000000.0 and x1<=15000000.0   and YY>0  order by fullCode,YearRef1 desc,uni2.DatasetID 
 ,x1,x2,x2,x4,x5,iPoint                    

   Retrieved rows: 74

