---Retrieve [,DA,,LEG/RS] from EXFOR SQL database---
___getX4SqlSearch_DA_LEGRS: Cu-0 n,el  and (En=0.253e6 or (En>=1.46e6 and En<=1.5e6))
SQL:
select t1.Entry                                           
 ,t1.DatasetID,t2.DatasetID as DS2                        
 ,t1.Target,t1.Reaction                                   
 ,t1.YearRef1,t1.nAuthors                                 
 ,t1.Author1Ini,t1.Author1                                
 ,t1.fullCode,t1.iPoint                                   
 ,t1.zaTarget1,t1.zaIncident1                             
 ,t1.Projectile,t1.sProd,t1.sTarg                         
 ,t2.fullCode as R2                                       
 ,t1.MF as MF ,t1.MT as MT                                
 ,t2.MF as MF2,t2.MT as MT2                               
 ,t1.y as LEGRS,t1.dy as dLEGRS                           
 ,t2.y as Sig,t2.dy as dSig                               
 ,t1.x1 as En,t1.dx1 as dEn,t1.dx1 as dEn2                
 ,t1.x2 as number                                         
 from uni1 as t1                                          
 inner join uni1 as t2 on t1.Entry=t2.Entry               
       and t1.x1=t2.x1                                    
 where 1=1                                                
 and (t1.Target like 'Cu-0')                        
 and (t1.Reaction like 'n,el')                       
 and (t1.SF58 like ',DA,,LEG/RS')                         
 and (t2.SF58 like ',SIG')                                
 and (t2.Target=t1.Target)                                
 and (t2.Reaction=t1.Reaction)                            
 and (t1.DatasetID='11749005' or t1.DatasetID='40940008') 
 and (t2.DatasetID='11749006' or t2.DatasetID='40940002') 

 and (En=0.253e6 or (En>=1.46e6 and En<=1.5e6))
 order by t1.fullCode,t1.YearRef1 desc                    
 ,t1.DatasetID,En,number                                  


