___getX4SqlSearch_DA_e: Cu-0 n,el  and (En=0.253e6 or (En>=1.46e6 and En<=1.5e6))
SQL:
select *                          
from da1                          
where (Target like 'Cu-0')  
  and (Reaction like 'n,el') 
--  and ((Author1 like 'Korzh') or (Author1 like 'Mellema'))
 and (En=0.253e6 or (En>=1.46e6 and En<=1.5e6))

