def corr_point(row):
    y  =row["y"]
    dy =row["dy"]
    m0 =row["m0"]
    dm0=row["dm0"]
    m1 =row["m1"]
    dm1=row["dm1"]
    #22209012		#1992 Y.Ikeda+       
    a0=0.358/0.348;     #correction to new 511 keV gamma-yield per decay Cu-64 
    a1=0.870/0.877;     #correction to new 355 keV gamma-yield per decay Au196 
    a3=a0*a1;           #total gamma-yield correction factor 
    fc=m1/m0*a3;	#total correction factor                   
    y=y*fc;		#correction exp. cs
    dy=dy*fc		#determination the absolute value of new total errorainty
    row["y"]=y
    row["dy"]=dy
    return 1

