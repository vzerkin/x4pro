 ,round(An) as Anint               
from da1                           
where (Target like 'Fe-56')   
  and (Reaction like 'n,el')  
 and (An>=39 and An<=39) and (En<=9e6)
order by fullCode,                 
  YearRef1 desc,DatasetID          
  ,Anint,En,iPoint                 


