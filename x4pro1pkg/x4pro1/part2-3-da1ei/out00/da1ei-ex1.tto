___getX4SqlSearchDA_a: O-16 p,el
SQL:
select *                           
 ,round(An) as Anint               
from da1                           
where (Target like 'O-16')   
  and (Reaction like 'p,el')  
 and (An>=138 and An<=141)
order by fullCode,                 
  YearRef1 desc,DatasetID          
  ,Anint,En,iPoint                 


