SQL:
select *                           
 ,round(An) as Anint               
from dap1                          
where (Target like 'Li-6')   
  and (Reaction like 'he3,p')  
 and (An=0 or An=150)
 and (En<=9e6)       
 and (Elv>=0)        

order by fullCode,                 
  YearRef1 desc,DatasetID          
  ,Anint,En,iPoint                 


