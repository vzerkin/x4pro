 Program: legrs2da.f (ver.2022-12-01)
 Author:  V.Zerkin, IAEA-NDS, 2021-2022
 Purpose: get LEG/RS and SIG from X4Pro;
    calculate LEG(0) from SIG and DA from LEG(*),A;
    output to C4: SIG(E), LEG(num), DA(A:0,180,3)
 Running: 2026-09-04,23:07:45

 Open database: ../../x4sqlite1.db ierr=           0

SQL command:
select t1.Entry                            
 ,t1.DatasetID,t2.DatasetID as DS2         
 ,t1.Target,t1.Reaction                    
 ,t1.YearRef1,t1.nAuthors                  
 ,t1.Author1Ini,t1.Author1                 
 ,t1.fullCode,t1.iPoint                    
 ,t1.zaTarget1,t1.zaIncident1              
 ,t1.Projectile,t1.sProd,t1.sTarg          
 ,t2.fullCode as R2                        
 ,t1.MF as MF ,t1.MT as MT                 
 ,t2.MF as MF2,t2.MT as MT2                
 ,t1.y as LEGRS,t1.dy as dLEGRS            
 ,t2.y as Sig,t2.dy as dSig                
 ,t1.x1 as En,t1.dx1 as dEn,t1.dx1 as dEn2 
 ,t1.x2 as number                          
 from uni1 as t1                           
 inner join uni1 as t2 on t1.Entry=t2.Entry
       and t1.x1=t2.x1                     
 where 1=1                                 
 and (t1.DatasetID='11749005'            
   or t1.DatasetID='40940008')           
 and (t2.DatasetID='11749006'            
   or t2.DatasetID='40940002')           
 order by t1.fullCode,t1.YearRef1 desc     
 ,t1.DatasetID,En,number                   

