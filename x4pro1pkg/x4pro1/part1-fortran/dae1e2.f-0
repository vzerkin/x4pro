!gfortran dae1e2.f sql1sub.c sqlite3.c -o dae1e2
!gfortran dae1e2.f sql1sub.c sqlite3.c -o dae1e2.exe -pthread -ldl
!
!gcc -c sqlite3.c sql1sub.c
!gfortran dae1e2.f sql1sub.o sqlite3.o -o dae1e2
!
!gcc -c sqlite3.c sql1sub.c
!gfortran -c dae1e2.f
!gfortran dae1e2.o sql1sub.o sqlite3.o -o dae1e2.exe -pthread -ldl
!
!dae1e2.exe >qq7.tto
!dae1e2.exe >dae1e2.tto.txt

	program dae1e2
	character*512  dbname
	character*512  outfile/'sql1tmp.dat'/
	character*4096 sql
	character*10 dat,tim

        write (*,*) 'Program: dae1e2.f (ver.2022-04-26)'
        write (*,*) 'by V.Zerkin, IAEA-NDS, 2021-2022'
	call date_and_time(DATE=dat,TIME=tim)
	write(*,'(a,a,1h-,a,1h-,a,1h,,a,1h:,a,1h:,a)') ' Running: ',
     1  dat(1:4),dat(5:6),dat(7:8),tim(1:2),tim(3:4),tim(5:6)
        write (*,*)

	dbname='C:\projects\zerkin\pdev\x4sqlite1.db'
	dbname='../../x4sqlite1.db'

	ierr=ix4lite_open(trim(dbname)//char(0)) !--- char(0) added for compatibility with C
	if (ierr.ne.0) then
	    write (*,*) 'Cant open database'
	    stop
	endif

	write (*,*) 'Open database: ',trim(dbname),' ierr=',ierr
        write (*,*)

	call getX4SqlSearch_DAE_e2(sql,'F-19','n,x','n')
	write (*,*) 'SQL command:'
	write (*,*) trim(sql)
	write (*,*) 

	sql=trim(sql)//char(0)
	outfile=trim(outfile)//char(0)
	ipnt=ix4lite_exec(sql,outfile)
	if (ierr.lt.0) then
	    write (*,*) 'SQL error ierr=',ipnt
	else
	    write (*,*) 'Operation done successfully:',ipnt,' points'
	endif

	call read_data(outfile,ipnt)

	call ix4lite_close();

	write(*,'(/a)') 'Program completed successfully'
	stop
	end



	subroutine read_data(infile,ipnt)
	character(len=*) infile
	character*132 line
	character*132 nam,val,fullCode,nowTrace,lastTrace
	character*9   DatasetID
	character*4   sYear
	character*12  Author1
	write (*,*)
	write (*,*) 'Read data:',ipnt,' points'
	nin=100
	open(unit=nin,file=infile,status='old',err=9999)
	iipnt=0
	lastTrace=''
	do
	    read(nin,'(a12,a)',end=8888) nam,line
!	    if (nam.eq.'////')      exit
	    if (nam.eq.'//EOF')      exit
	    if (nam.eq.'$DatasetID') DatasetID=line
	    if (nam.eq.'$fullCode')  fullCode=line
	    if (nam.eq.'$YearRef1')  read(line,'(i11)') iYear
	    if (nam.eq.'$YearRef1')  sYear=line
	    if (nam.eq.'$Author1')   Author1=line
	    if (nam.eq.'$iPoint')    read(line,'(i11)')   iPoint
	    if (nam.eq.'$Sig')       read(line,'(e11.0)') Sig
	    if (nam.eq.'$dSig')      read(line,'(e11.0)') dSig
	    if (nam.eq.'$En')        read(line,'(e11.0)') En
	    if (nam.eq.'$dEn')       read(line,'(e11.0)') dEn
	    if (nam.eq.'$Eout')      read(line,'(e11.0)') Eout
	    if (nam.eq.'$dEout')     read(line,'(e11.0)') dEout
	    if (nam.eq.'$An')        read(line,'(e11.0)') An
	    if (nam.eq.'$dAn')       read(line,'(e11.0)') dAn
	    if (nam(1:4).eq.'####') then !--- Begin of new Datapoint
		iipnt=iipnt+1
		DatasetID=''
		fullCode=''
		iYear=0
		sYear='----'
		Author1=''
		iPoint=-1
		Sig=-1
		dSig=0
		En=-1
		dEn=0
		Eout=-1
		dEout=0
		An=-777
		dAn=0
		cycle
	    endif
	    if (nam.eq.'//') then !--- End of Datapoint
		write(nowTrace,*) DatasetID,' Ei=',En,' An=',An
     1				,' ',sYear,',',trim(Author1)
		if (nowTrace.ne.lastTrace) then
		    write(*,*) '---new trace---',trim(nowTrace)
		    lastTrace=nowTrace
		endif
		write(*,*) iipnt,iPoint,DatasetID,' ',sYear,',',Author1
!     1		,' En=',En,' An=',An,' Eo=',Eout,' XS=',Sig
     1		,' Eo=',Eout,' XS=',Sig
	    endif
	enddo
8888	close(nin)
9999	return
	end



	subroutine getX4SqlSearch_DAE_e2(sql,target,react,prod)
	character*4096 sql
	character(len=*) target,react,prod
	sql=''
     1	//'select * from dae1                    '//char(10)
     1	//' where (Target like '''//target//''') '//char(10)
     1	//' and (Reaction like '''//react//''')  '//char(10)
     1	//' and (outParticles like ''%['//prod//']%'')'//char(10)
!     1	//' and ((An>=25) and (An<=45))          '//char(10)
     1	//' order by fullCode,                   '//char(10)
     1	//'  YearRef1 desc,DatasetID,            '//char(10)
     1	//'  En,An,Eout,iPoint                   '
	return
	end
