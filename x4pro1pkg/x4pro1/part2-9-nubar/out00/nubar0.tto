---getX4SqlSearch_NUBAR: U-235 n,f pr,nu  and sf8='' 
SQL:
select *                                  
 ,y  as YY, dy  as dYY                    
 ,x1 as En, dx1 as dEn                    
from uni1                                 
where                                     
 Target like 'U-235'                 
 and Reaction like 'n,f'            
 and SF58 like 'pr,nu'                 
 and x2 is null                           
 and sf8=''  
order by fullCode,YearRef1 desc,DatasetID 
 ,En,iPoint                               


